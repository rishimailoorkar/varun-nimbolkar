{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|audio/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/gallery/:path*",
      "headers": [
        {
          "value": "public, max-age=31536000, immutable",
          "key": "Cache-Control"
        }
      ]
    }
  ]
}
